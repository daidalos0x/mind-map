{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mind",
  "version": "0.1.0",
  "identifier": "com.huanyuli.mindmap",
  "build": {
    "frontendDist": "../../desktop-dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "node ensure-web.mjs",
    "beforeBuildCommand": "node prepare-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mind",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": ["smm"],
        "name": "Mind",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ]
  }
}
